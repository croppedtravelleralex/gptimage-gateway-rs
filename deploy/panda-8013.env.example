# Panda :8013 parity — copy to secrets/ and source before bringup.
# See docs/28-decisions-20260727.md §2.
#
#   set -a && source deploy/panda-8013.env.example && set +a
#   PANDA_ALIGN=1 bash scripts/panda_bringup_rust_face.sh

PANDA_ALIGN=1
AUTH_DISABLE=1
IMAGE_ENABLED=1
GATEWAY_LISTEN=0.0.0.0:8013
# HELPER_INTERNAL_TOKEN=...  # or secrets/helper_token on disk

# :8012 API-key parity (optional; do not combine with AUTH_DISABLE=1):
# AUTH_DISABLE=0
# GATEWAY_AUTH_KEY=your-config-auth-key
# GATEWAY_LISTEN=127.0.0.1:8013
