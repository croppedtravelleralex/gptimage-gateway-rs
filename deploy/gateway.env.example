# Copy to secrets/gateway.env on the target host (not in git).
# Used by deploy/independent-compose.yml via env_file.

DATA_PLANE=upstream
IMAGE_ENABLED=1
GATEWAY_LISTEN=0.0.0.0:8014
PIN_ACCOUNT_FILE=/secrets/pin_account.json
ACCOUNTS_FILE=/secrets/accounts_pool.json
AUTH_DB_PATH=/data/auth.db
RUST_LOG=info

# JWT + bootstrap admin (required when AUTH_DISABLE=0)
AUTH_DISABLE=0
AUTH_MODE=jwt
# Generate: openssl rand -hex 32
AUTH_JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
AUTH_BOOTSTRAP_ADMIN_USER=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Baked into GHCR image when built from Dockerfile.gateway
# B2 image URL proxy (response_format=url for TNexus / browser <img>)
# Public base for signed asset URLs (required in production behind reverse proxy)
# GATEWAY_PUBLIC_BASE_URL=https://rs.gptimage.relai.asia
# GATEWAY_IMAGE_ASSET_TTL_SECS=86400
# GATEWAY_ASSET_HMAC_KEY=  # optional; falls back to GATEWAY_AUTH_KEY or AUTH_JWT_SECRET

