# syntax=docker/dockerfile:1
# Build linux/amd64 gateway + upstream-probe + static Web UI for independent deploy.
# Never build on panda — only pull from GHCR after CI publish.
FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM rust:1.88-bookworm AS build
WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends libclang-dev clang cmake pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
RUN cargo build --release -p gateway -p upstream-probe

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/gptimage-gateway-rs /usr/local/bin/gptimage-gateway-rs
COPY --from=build /src/target/release/upstream-probe /usr/local/bin/upstream-probe
COPY --from=web /web/out /var/www/gateway-ui
ENV GATEWAY_LISTEN=0.0.0.0:8013
ENV GATEWAY_STATIC_DIR=/var/www/gateway-ui
EXPOSE 8013
ENTRYPOINT ["/usr/local/bin/gptimage-gateway-rs"]
